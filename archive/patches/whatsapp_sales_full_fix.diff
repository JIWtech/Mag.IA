+/* Bolhas de Mensagem */
+.bubble {
+  position: relative;
+  width: fit-content;
+  min-width: 68px;
+  max-width: 62%;
+  padding: 9px 12px 7px;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.16);
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  word-break: break-word;
+  overflow-wrap: break-word;
+  margin-top: 5px;
+  box-sizing: border-box;
+  transition: transform 120ms ease;
+}
+
+.bubble.is-group-start {
+  margin-top: 15px;
+}
+
+.bubble:first-child {
+  margin-top: 4px;
+}
