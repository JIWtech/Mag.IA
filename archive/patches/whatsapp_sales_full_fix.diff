+/* Timeline & Mensagens */
+.message-stream {
+  padding: 14px 22px 18px;
+  overflow-y: auto;
+  height: 100%;
+  min-height: 0;
+  background: radial-gradient(ellipse at 50% 10%, #0f192d 0%, #080e1a 100%);
+  display: flex;
+  flex-direction: column;
+}
+
+.message-stream-inner {
+  width: 100%;
+  max-width: 100%;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+}
+
+/* Separador de Data Centralizado com Linha */
+.date-separator {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin: 22px 0 14px;
+  width: 100%;
+  position: relative;
+}
+
+.date-separator::before {
+  content: '';
+  position: absolute;
+  left: 8%;
+  right: 8%;
+  height: 1px;
+  background: rgba(255, 255, 255, 0.06);
+  z-index: 0;
+}
+
+.date-separator-pill {
+  position: relative;
+  z-index: 1;
+  padding: 3px 14px;
+  border-radius: 9999px;
+  background: rgba(15, 23, 42, 0.9);
+  backdrop-filter: blur(8px);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  font-size: 11px;
+  font-weight: 500;
+  color: #94a3b8;
+  letter-spacing: 0.2px;
+  user-select: none;
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
+}
+
+/* Eventos de Sistema (Central Pill com Linha) */
+.system-event-row {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  margin: 12px 0;
+  width: 100%;
+  position: relative;
+}
+
+.system-event-row::before {
+  content: '';
+  position: absolute;
+  left: 14%;
+  right: 14%;
+  height: 1px;
+  background: rgba(255, 255, 255, 0.04);
+  z-index: 0;
+}
+
+.system-event-pill {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 3px 13px;
+  border-radius: 9999px;
+  background: rgba(15, 23, 42, 0.88);
+  backdrop-filter: blur(8px);
+  border: 1px solid rgba(255, 255, 255, 0.06);
+  font-size: 11px;
+  color: #94a3b8;
+  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
+  user-select: none;
+}
+
+.system-event-text {
+  font-weight: 500;
+  color: #cbd5e1;
+}
+
+.system-event-time {
+  font-size: 10px;
+  color: #64748b;
+}
