      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst body = data.body || data;\nif (!body.object || body.object !== 'instagram') return [];\nconst entries = body.entry || [];\nif (entries.length === 0) return [];\nconst entry = entries[0];\nconst messaging = (entry.messaging || [])[0];\nif (!messaging) return [];\nconst isEcho = messaging.message?.is_echo || false;\nif (isEcho) return [];\nconst senderId = messaging.sender?.id || '';\nconst messageId = messaging.message?.mid || 'msg_' + Date.now();\nconst messageText = messaging.message?.text || '';\nconst attachments = messaging.message?.attachments || [];\nlet messageType = 'text';\nlet attachmentUrl = '';\nif (attachments.length > 0) {\n  const att = attachments[0];\n  if (att.type === 'audio') { messageType = 'audio'; attachmentUrl = att.payload?.url || ''; }\n  else if (att.type === 'image') { messageType = 'image'; attachmentUrl = att.payload?.url || ''; }\n  else if (att.type === 'video') { messageType = 'video'; attachmentUrl = att.payload?.url || ''; }\n  else if (att.type === 'story_mention') { messageType = 'story_mention'; }\n}\nif (!senderId) return [];\nreturn { json: { senderId, messageId, messageText, messageType, attachmentUrl, isFromMe: false } };"
