    {
      "parameters": {
        "jsCode": "const out = $('Agente IA (Instagram)').item.json.output?.response || $('Agente IA (Instagram)').item.json.output || '';\nlet tl = out.replace(/\\[HUMANO_SOLICITADO\\]/gi, '').trim();\nif (!tl) tl = 'Desculpe a instabilidade. Pode repetir?';\nconst re = /AGENDAMENTO_CONFIRMADO[\\s\\S]*?Data:\\s*([\\d\\/]+)[\\s\\S]*?Horario:\\s*([\\d:]+)/i;\nconst m = out.match(re);\nlet r = { visita_agendada: false, texto_para_cliente: tl };\nif (m) {\n  r.visita_agendada = true; r.data_visita = m[1]; r.hora_visita = m[2];\n  r.veiculo_interesse = 'Interesse Geral';\n  const vm = out.match(/Veiculo:\\s*([^\\n]+)/i);\n  if (vm) r.veiculo_interesse = vm[1].trim();\n  r.texto_para_cliente = 'Agendamento confirmado! Visita: ' + r.veiculo_interesse + ' - ' + r.data_visita + ' as ' + r.hora_visita + '. Local: Av. das Americas 3.301, Barra da Tijuca.';\n}\nconst ctx = $('Preparar Contexto').first().json;\nr.instagram_id = ctx.instagram_id; r.created_at = ctx.created_at; r.isNew = ctx.isNew;\nreturn { json: { ...$input.item.json, ...r } };"
      },
